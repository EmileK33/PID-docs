# PID Analyzer — environment variable schema (§1.12).
#
# Copy to `.env` and fill in the <REQUIRED> values. The API refuses to start
# (sys.exit 1) if any "Refuse to start" variable is missing or invalid. Values
# shown are the documented defaults; <REQUIRED> means there is no default.
#
# Startup behaviour legend (from §1.12):
#   [REQUIRED]   Refuse to start if absent or invalid.
#   [WARN]       Log a warning; continue with documented fallback.
#   [DEFAULT]    Use the documented default if absent/invalid.

# --- Datastores ---
DATABASE_URL=<REQUIRED>                         # [REQUIRED] PostgreSQL connection URI
REDIS_URL=<REQUIRED>                            # [REQUIRED] Redis connection URI

# --- Object storage (S3) ---
S3_BUCKET_NAME=<REQUIRED>                        # [REQUIRED] any non-empty string
S3_REGION=<REQUIRED>                             # [REQUIRED] AWS region code, e.g. eu-central-1
AWS_ACCESS_KEY_ID=                               # [WARN] absent → use IAM role
AWS_SECRET_ACCESS_KEY=                           # [WARN] absent → use IAM role

# --- Auth (Supabase) ---
SUPABASE_URL=<REQUIRED>                          # [REQUIRED] HTTPS URL
SUPABASE_SERVICE_ROLE_KEY=<REQUIRED>             # [REQUIRED] any non-empty string
JWT_RS256_PUBLIC_KEY=<REQUIRED>                  # [REQUIRED] PEM-encoded RSA public key

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=<REQUIRED>                     # [REQUIRED] sk_live_* or sk_test_*
STRIPE_WEBHOOK_SECRET=<REQUIRED>                 # [REQUIRED] whsec_*

# --- Email (SendGrid) ---
SENDGRID_API_KEY=<REQUIRED>                      # [REQUIRED] any non-empty string

# --- Analytics (PostHog) ---
POSTHOG_API_KEY=                                 # [WARN] absent → analytics disabled
POSTHOG_HOST=https://app.posthog.com             # [DEFAULT] HTTPS URL

# --- Security ---
HMAC_SERVER_SECRET=<REQUIRED>                    # [REQUIRED] high-entropy string (anonymous_id derivation)

# --- ML model ---
ML_MODEL_S3_KEY=<REQUIRED>                       # [REQUIRED] S3 object key path
ML_MODEL_VERSION=                                # [WARN] absent → use latest in bucket

# --- ODA File Converter ---
ODA_CONVERTER_PATH=<REQUIRED>                    # [REQUIRED] absolute filesystem path
ODA_LICENSE_EXPIRY_DATE=                         # [WARN] YYYY-MM-DD (30-day alert threshold)

# --- Limits / tunables ---
MAX_UPLOAD_SIZE_BYTES=104857600                  # [DEFAULT] 100 MB
PRESIGNED_URL_EXPIRY_SECONDS=900                 # [DEFAULT] 15 min
ML_JOB_TIMEOUT_SECONDS=1200                      # [DEFAULT] 20 min

# --- Celery ---
CELERY_BROKER_URL=                               # absent → falls back to REDIS_URL

# --- Region / environment ---
DATA_REGION=eu-central-1                         # [DEFAULT] eu-central-1 | us-east-1
ENVIRONMENT=production                           # [DEFAULT] development | staging | production
